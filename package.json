{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migration-file-language sql --migration-filename-format index",
    "seed": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "eval": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.174",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.170",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
