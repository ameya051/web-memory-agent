# Required
OPENROUTER_API_KEY=
EXA_API_KEY=
# Hosted Postgres (Neon or Supabase) connection string.
# Use sslmode=verify-full to avoid pg's sslmode warning.
DATABASE_URL=

# Optional: OpenRouter model id for the main chat model
MODEL_MAIN=anthropic/claude-sonnet-5.5
# Optional: OpenRouter model id for claim extraction, which runs after each answer
MODEL_EXTRACT=anthropic/claude-haiku-5.5

# Optional, dev only: what "now" is when the server starts, e.g. 2026-11-13T10:00:00+05:30.
# The dev panel can also move the clock while the server runs.
DEV_CLOCK=

# Required for tests: a throwaway Postgres database, never DATABASE_URL.
# Tests TRUNCATE its tables.
TEST_DATABASE_URL=
