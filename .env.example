# Required
OPENROUTER_API_KEY=
EXA_API_KEY=
# Hosted Postgres (Neon or Supabase) connection string.
# Use sslmode=verify-full to avoid pg's sslmode warning.
DATABASE_URL=

# Optional: OpenRouter model id for the main chat model
MODEL_MAIN=anthropic/claude-sonnet-5.5

# Required for tests: a throwaway Postgres database, never DATABASE_URL.
# Tests TRUNCATE its tables.
TEST_DATABASE_URL=
